{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civic-orchestrator:schema:common:v1",
  "title": "Civic Orchestrator Common Types v1",
  "type": "object",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "operation": {
      "type": "string",
      "pattern": "^(publication|geography|participant|repository|rag|inference|edge|firmware|signing|audit|incident)\\.[a-z][a-z0-9._-]*$",
      "maxLength": 160
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "client_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]*$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civic-orchestrator:schema:custom-command-access:v1",
  "title": "Civic Custom Command Access v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "policy",
    "defaults",
    "qualification_semantics",
    "participants"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "policy": {
      "const": "civic-custom-command-access"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discover",
        "invoke"
      ],
      "properties": {
        "discover": {
          "const": false
        },
        "invoke": {
          "const": false
        }
      }
    },
    "qualification_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptive_only",
        "automatic_grants"
      ],
      "properties": {
        "descriptive_only": {
          "const": true
        },
        "automatic_grants": {
          "const": false
        }
      }
    },
    "participants": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "participant_id",
          "active",
          "qualifications",
          "command_access"
        ],
        "properties": {
          "participant_id": {
            "type": "string",
            "pattern": "^participant:[A-Za-z0-9._:-]{1,200}$"
          },
          "active": {
            "type": "boolean"
          },
          "qualifications": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status",
                "recorded_by",
                "recorded_at"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "current",
                    "historical",
                    "pending",
                    "revoked"
                  ]
                },
                "recorded_by": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "recorded_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 500
                }
              }
            }
          },
          "command_access": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "codename",
                "discover",
                "invoke",
                "granted_by",
                "granted_at",
                "reason"
              ],
              "properties": {
                "codename": {
                  "type": "string",
                  "pattern": "^[a-z]{1,5}-[a-z]{1,5}$"
                },
                "discover": {
                  "type": "boolean"
                },
                "invoke": {
                  "type": "boolean"
                },
                "granted_by": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "granted_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "expires_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "invoke": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "discover": {
                        "const": true
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}

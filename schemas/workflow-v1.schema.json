{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:civic-orchestrator:schema:workflow:v1",
  "title":"Civic Workflow State v1",
  "type":"object",
  "additionalProperties":false,
  "required":["workflow_id","request_id","operation","state","created_at","updated_at"],
  "properties":{
    "workflow_id":{"$ref":"urn:civic-orchestrator:schema:common:v1#/$defs/id"},
    "request_id":{"$ref":"urn:civic-orchestrator:schema:common:v1#/$defs/id"},
    "operation":{"$ref":"urn:civic-orchestrator:schema:common:v1#/$defs/operation"},
    "state":{"type":"string","enum":["received","validated","authorized","accepted","waiting","completed","rejected","failed","not-implemented"]},
    "created_at":{"$ref":"urn:civic-orchestrator:schema:common:v1#/$defs/timestamp"},
    "updated_at":{"$ref":"urn:civic-orchestrator:schema:common:v1#/$defs/timestamp"},
    "previous_state":{"type":"string"},
    "side_effects":{"type":"boolean"}
  }
}
